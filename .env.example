# Opcional: el formulario ya funciona sin configuración con FormSubmit,
# enviando los mensajes a fpaulina545@gmail.com.
#
# Si prefieres Formspree:
# 1. Crea un formulario en https://formspree.io
# 2. Copia este archivo a .env.local
# 3. Pega aquí el endpoint (https://formspree.io/f/XXXXXXXX)
# 4. Reinicia npm run dev
#
# FORMSPREE_ENDPOINT=https://formspree.io/f/TU_FORM_ID
