# Configuración del formulario de contacto con Brevo
#
# 1. Crea una cuenta en https://www.brevo.com
# 2. Verifica una dirección de remitente en Brevo (SMTP/Email → Senders).
# 3. Genera una clave API en https://app.brevo.com/settings/keys/api
# 4. Copia este archivo a `.env.local`, rellena los valores y reinicia `npm run dev`.

# Obligatoria: clave API de Brevo con permisos de envío.
BREVO_API_KEY=tu_clave_api_de_brevo

# Remitente verificado en Brevo. Si se omite, se usa profile.email.
BREVO_SENDER_EMAIL=ejemplito5@gmail.com
BREVO_SENDER_NAME=Nombre apellido

# Correo que recibe los mensajes del formulario. Si se omite, se usa profile.email.
BREVO_TO_EMAIL=ejemplito@gmail.com
